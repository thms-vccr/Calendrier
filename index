<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Notre Avent</title>

<style>
:root {
  --ivoire: #fff9ef;
  --or: #e9d5a4;
  --vert: #17231f;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  color: var(--ivoire);
  font-family: Georgia, "Times New Roman", serif;
  background: var(--vert);
}

.fond {
  position: fixed;
  inset: 0;
  z-index: -1;
  background:
    linear-gradient(rgba(10,20,16,.45), rgba(10,20,16,.60)),
    url("images/fond.jpg") center / cover no-repeat;
}

.accueil {
  min-height: 100vh;
  padding: 28px 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.entete {
  text-align: center;
  margin-bottom: 15px;
}

.surtitre {
  color: var(--or);
  font: 600 11px Arial, sans-serif;
  letter-spacing: 4px;
  text-transform: uppercase;
}

h1 {
  font-size: clamp(36px, 6vw, 64px);
  font-weight: normal;
  margin: 12px 0;
}

.entete p {
  font-size: 16px;
}

.calendrier {
  position: relative;
  width: min(100%, 1000px);
  height: min(70vh, 700px);
  min-height: 440px;
}

.case {
  position: absolute;
  left: var(--x);
  top: var(--y);
  transform: translate(-50%, -50%);
  width: 44px;
  height: 44px;
  border: 1px solid rgba(255,255,255,.8);
  border-radius: 50%;
  background: rgba(23,35,31,.78);
  color: white;
  cursor: pointer;
  font: 14px Arial, sans-serif;
  transition: .2s;
}

.case:hover:not(:disabled) {
  transform: translate(-50%, -50%) scale(1.13);
  background: var(--or);
  color: var(--vert);
}

.case:disabled {
  opacity: .55;
  cursor: not-allowed;
  border-style: dashed;
}

.pied {
  margin-top: 18px;
  font: 12px Arial, sans-serif;
  text-align: center;
}

.decouverte {
  min-height: 100vh;
  padding: 25px 15px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.photo-cadre {
  width: min(94vw, 850px);
  padding: 8px;
  background: var(--ivoire);
  box-shadow: 0 15px 50px #0008;
}

.photo-cadre img {
  display: block;
  width: 100%;
  max-height: 68vh;
  object-fit: contain;
}

.retour {
  margin-top: 24px;
  padding: 12px 20px;
  color: var(--ivoire);
  border: 1px solid var(--ivoire);
  border-radius: 30px;
  text-decoration: none;
  font: 13px Arial, sans-serif;
  background: rgba(23,35,31,.8);
}

.retour:hover {
  background: var(--or);
  color: var(--vert);
}

.cache {
  display: none !important;
}

@media (max-width: 500px) {
  .calendrier {
    height: 65vh;
    min-height: 430px;
  }

  .case {
    width: 34px;
    height: 34px;
    font-size: 11px;
  }
}
</style>
</head>

<body>

<div class="fond"></div>

<!-- PAGE D'ACCUEIL -->
<main id="accueil" class="accueil">
  <header class="entete">
    <div class="surtitre">24 jours · 24 souvenirs</div>
    <h1>Notre Avent</h1>
    <p>Un petit souvenir à découvrir chaque jour.</p>
  </header>

  <section id="calendrier"
           class="calendrier"
           aria-label="Calendrier de l'Avent">
  </section>

  <footer class="pied">
    ♥ Avec tendresse, pour toi ♥
  </footer>
</main>

<!-- PAGE PHOTO -->
<main id="decouverte" class="decouverte cache">
  <div class="surtitre" id="date"></div>
  <h1>Le souvenir du jour</h1>

  <div class="photo-cadre">
    <img id="photo" src="" alt="Notre souvenir">
  </div>

  <a class="retour" id="retour" href="./">
    ← Retour au calendrier
  </a>
  <p id="message" role="status"></p>
</main>

<script>
// POSITION DES 24 CASES SUR LA PHOTO DE FOND
// x = position horizontale en %, y = position verticale en %
const positions = [
  [10,15], [27,12], [44,19], [63,12], [82,17], [94,30],
  [16,34], [34,31], [53,36], [72,31], [88,45], [8,53],
  [25,51], [44,57], [63,51], [80,59], [94,68], [14,74],
  [32,77], [50,72], [68,79], [84,82], [38,92], [61,92]
];

// DATE DU JOUR : du 1er au 24 décembre
function jourDisponible() {
  const maintenant = new Date();

  if (maintenant.getMonth() < 11) return 0;
  if (maintenant.getMonth() > 11) return 24;

  return 24;
}

// CHEMIN DE LA PHOTO DE CHAQUE JOUR
function cheminPhoto(numero) {
  return "images/jour-" +
    String(numero).padStart(2, "0") + ".jpg";
}

// CRÉATION DES 24 CASES
const calendrier = document.getElementById("calendrier");

positions.forEach((position, index) => {
  const numero = index + 1;
  const bouton = document.createElement("button");

  bouton.className = "case";
  bouton.textContent = String(numero).padStart(2, "0");

  bouton.style.setProperty("--x", position[0] + "%");
  bouton.style.setProperty("--y", position[1] + "%");

  bouton.disabled = numero > jourDisponible();
  bouton.setAttribute(
    "aria-label",
    "Case " + numero
  );

  bouton.addEventListener("click", () => {
    if (numero <= jourDisponible()) {
      window.location.href =
        "?jour=" + String(numero).padStart(2, "0");
    }
  });

  calendrier.appendChild(bouton);
});

// AFFICHAGE DE LA PHOTO DEMANDÉE
const parametres = new URLSearchParams(
  window.location.search
);
const numero = Number(parametres.get("jour"));

if (parametres.has("jour")) {
  document.getElementById("accueil")
    .classList.add("cache");

  document.getElementById("decouverte")
    .classList.remove("cache");

  const date = document.getElementById("date");
  const photo = document.getElementById("photo");
  const message = document.getElementById("message");

  document.getElementById("retour").href =
    window.location.pathname;

  if (
    Number.isInteger(numero) &&
    numero >= 1 &&
    numero <= jourDisponible()
  ) {
    date.textContent =
      "Le " + numero +
      (numero === 1 ? "er" : "") +
      " décembre";

    photo.src = cheminPhoto(numero);

    photo.onerror = () => {
      message.textContent =
        "Ajoute la photo jour-" +
        String(numero).padStart(2, "0") +
        ".jpg dans le dossier images.";
    };
  } else {
    date.textContent = "Encore un peu de patience";
    photo.classList.add("cache");
    message.textContent =
      "Cette case n'est pas encore disponible.";
  }
}
</script>

</body>
</html>
